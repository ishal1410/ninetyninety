# AgentRouter (Claude via OpenAI-compatible gateway) -- takes priority if set
AGENTROUTER_API_KEY=
# AGENTROUTER_MODEL_ID=claude-opus-5   # or claude-opus-4-8; nothing else is served
# Google AI Studio key -- https://aistudio.google.com/apikey (free tier, no card)
GOOGLE_API_KEY=
